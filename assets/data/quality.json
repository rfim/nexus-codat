"# the quality gate on the canonical invoice, before anything reaches gold\ninvoice_quality:\n  on_failure: quarantine\n  rules:\n    ids_present: \"company_id IS NOT NULL AND source_invoice_id IS NOT NULL\"\n    status_known: \"status IN ('draft','open','paid','void')\"\n    currency_iso: \"currency IN ('GBP','EUR','USD')\"\n    due_after_issue: \"due_date IS NULL OR due_date >= issue_date\"\n    not_far_future: \"issue_date <= DATE'2026-09-30' + INTERVAL 366 DAYS\"\n"